{
  "name": "readme-gen",
  "version": "1.0.0",
  "description": "A small CLI that generates a README.md for a Node project by reading its package.json and git remote.",
  "main": "index.js",
  "bin": {
    "readme-gen": "./index.js"
  },
  "scripts": {
    "check": "node --check index.js"
  },
  "keywords": [
    "readme",
    "cli",
    "generator"
  ],
  "author": "Riley Jordan",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.5.0",
    "inquirer": "^12.9.0",
    "language-detect": "^1.1.0",
    "license-checker": "^25.0.1"
  }
}
